# Local dev: SQLite file. To move to Postgres, flip the datasource provider in
# prisma/schema.prisma to "postgresql" and put a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# Every "today" / "this week" boundary in the app is computed against this zone,
# not the server locale and not the phone's clock, so all leaderboards agree.
EVENT_TIMEZONE="America/New_York"

# The drinking day starts at this hour (local to EVENT_TIMEZONE), so a night
# that runs past midnight stays on one day. 6 = 6am.
EVENT_DAY_START_HOUR="6"
